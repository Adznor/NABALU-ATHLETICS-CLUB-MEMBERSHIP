{
  "entities": {
    "Member": {
      "title": "Member",
      "description": "Athlete or Individual member of Nabalu Athletics Club",
      "type": "object",
      "properties": {
        "fullName": { "type": "string" },
        "icNumber": { "type": "string" },
        "dob": { "type": "string" },
        "gender": { "type": "string", "enum": ["Lelaki", "Perempuan"] },
        "address": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "guardianName": { "type": "string" },
        "guardianPhone": { "type": "string" },
        "guardianIc": { "type": "string", "description": "IC number of the guardian" },
        "membershipType": { "type": "string", "enum": ["Ahli Individu", "Ahli Remaja", "Ahli Kehormat"] },
        "registrationFeePaid": { "type": "boolean" },
        "registrationFeeVerifiedAt": { "type": "string", "format": "date-time" },
        "annualPayments": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "year": { "type": "number" },
              "paid": { "type": "boolean" },
              "verifiedAt": { "type": "string", "format": "date-time" }
            }
          }
        },
        "photoBase64": { "type": "string", "description": "Mug shot" },
        "receiptBase64": { "type": "string", "description": "Payment receipt" },
        "membershipId": { "type": "string", "description": "Generated after verification" },
        "status": { "type": "string", "enum": ["pending", "verified", "cancelled"] },
        "cancellationReason": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time", "description": "Tarikh Permohonan" },
        "verifiedAt": { "type": "string", "format": "date-time", "description": "Tarikh Disahkan" },
        "cancelledAt": { "type": "string", "format": "date-time", "description": "Tarikh Dibatalkan" },
        "membershipNumber": { "type": "number", "description": "Sequence number for NAC001 format" }
      },
      "required": ["fullName", "icNumber", "membershipType", "status", "createdAt"]
    },
    "Counter": {
      "title": "Counter",
      "description": "Counter for auto-incrementing membership IDs",
      "type": "object",
      "properties": {
        "count": { "type": "number" }
      }
    },
    "AppSetting": {
      "title": "AppSetting",
      "description": "Club settings and content",
      "type": "object",
      "properties": {
        "clubName": { "type": "string" },
        "clubNameEn": { "type": "string" },
        "mission": { "type": "string" },
        "missionEn": { "type": "string" },
        "vision": { "type": "string" },
        "visionEn": { "type": "string" },
        "logoUrl": { "type": "string" },
        "terms": { "type": "string" },
        "termsPdfUrl": { "type": "string" },
        "bankInfo": { "type": "string" },
        "registrationOpen": { "type": "boolean", "description": "Toggles membership registration visibility" }
      }
    },
    "LogEntry": {
      "title": "Log Entry",
      "description": "Activity log for actions taken in the system",
      "type": "object",
      "properties": {
        "category": { "type": "string", "enum": ["member", "system", "payment"] },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "adminId": { "type": "string" },
        "adminEmail": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" },
        "targetMemberId": { "type": "string" }
      },
      "required": ["category", "action", "details", "adminId", "adminEmail", "timestamp"]
    },
    "User": {
      "title": "Registered User",
      "description": "User who can submit membership applications",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "displayName": { "type": "string" },
        "email": { "type": "string" },
        "password": { "type": "string", "description": "Stored for admin access - NOT RECOMMENDED in production but requested by user" },
        "authProvider": { "type": "string", "enum": ["google", "email"] },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "authProvider", "createdAt"]
    }
  },
  "firestore": {
    "/logs/{logId}": {
      "schema": "LogEntry",
      "description": "System-wide activity and payment logs"
    },
    "/members/{memberId}": {
      "schema": "Member",
      "description": "Members collection"
    },
    "/counters/members": {
      "schema": "Counter",
      "description": "Global counter for membership IDs"
    },
    "/settings/club": {
      "schema": "AppSetting",
      "description": "Club configuration"
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Registered application users"
    }
  }
}
