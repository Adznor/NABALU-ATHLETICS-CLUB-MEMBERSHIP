rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // --- PHASE 3: Primitives ---
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      // Bootstrapped Admin: Only the specified email with verified status
      return isSignedIn() && 
             request.auth.token.email == "g-73273737@moe-dl.edu.my" && 
             request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- PHASE 4: Entity Validation ---

    function isValidMember(data) {
      return data.keys().hasAll([
        'fullName', 'icNumber', 'membershipType', 'status', 'createdAt'
      ]) &&
      data.fullName is string && data.fullName.size() <= 200 &&
      data.icNumber is string && data.icNumber.size() <= 50 &&
      data.membershipType in ['Ahli Individu', 'Ahli Remaja'] &&
      data.isOku is bool &&
      data.status in ['pending', 'verified', 'expired', 'cancelled'] &&
      data.createdAt is timestamp &&
      // Optional fields and size limits
      (!data.keys().contains('membershipId') || data.membershipId == null || (data.membershipId is string && data.membershipId.size() <= 50)) &&
      (!data.keys().contains('membershipNumber') || data.membershipNumber == null || data.membershipNumber is number) &&
      (!data.keys().contains('dob') || data.dob == null || data.dob is string) &&
      (!data.keys().contains('gender') || data.gender == null || data.gender is string) &&
      (!data.keys().contains('verifiedAt') || data.verifiedAt == null || data.verifiedAt is timestamp) &&
      (!data.keys().contains('cancelledAt') || data.cancelledAt == null || data.cancelledAt is timestamp) &&
      (!data.keys().contains('expiryDate') || data.expiryDate == null || data.expiryDate is timestamp) &&
      (!data.keys().contains('email') || data.email == null || (data.email is string && data.email.size() <= 200)) &&
      (!data.keys().contains('phone') || data.phone == null || (data.phone is string && data.phone.size() <= 50)) &&
      (!data.keys().contains('address') || data.address == null || (data.address is string && data.address.size() <= 1000)) &&
      (!data.keys().contains('guardianName') || data.guardianName == null || (data.guardianName is string && data.guardianName.size() <= 200)) &&
      (!data.keys().contains('guardianPhone') || data.guardianPhone == null || (data.guardianPhone is string && data.guardianPhone.size() <= 50)) &&
      (!data.keys().contains('cancellationReason') || data.cancellationReason == null || (data.cancellationReason is string && data.cancellationReason.size() <= 1000)) &&
      (!data.keys().contains('photoBase64') || data.photoBase64 == null || data.photoBase64 is string) &&
      (!data.keys().contains('receiptBase64') || data.receiptBase64 == null || data.receiptBase64 is string);
    }

    // --- RULES ---

    match /members/{memberId} {
      // Registration: Anyone can create a "pending" member if it passes validation
      allow create: if 
        isValidId(memberId) && (
          isAdmin() || (
            isValidMember(incoming()) &&
            incoming().status == 'pending' &&
            incoming().createdAt == request.time
          )
        );

      // Public Access for viewing members
      allow list, get: if true;

      // Update: Admin can modify anything related to members
      allow update: if isAdmin();

      // Delete: Only Admin
      allow delete: if isAdmin();
    }

    match /counters/members {
      allow read: if true;
      allow create: if incoming().count == 1;
      allow update: if incoming().count == existing().count + 1;
    }

    match /settings/club {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
